# Copy to .env and edit. Generate the secrets with:
#   openssl rand -base64 48   (SECRET_KEY_BASE)
#   openssl rand -base64 8    (SIGNING_SALT)
#   openssl rand -base64 24   (DB_PASSWORD)
AKKOMA_HOST=social.example.org
AKKOMA_SCHEME=https
AKKOMA_NAME=My Akkoma
SECRET_KEY_BASE=
SIGNING_SALT=
DB_PASSWORD=
# AKKOMA_IMAGE=ghcr.io/hugmesh/hugmesh-akkoma:0.5.1-beta.1
# AKKOMA_WEB_IMAGE=ghcr.io/hugmesh/hugmesh-akkoma-web:0.5.1-beta.1
# WEB_PORT=8080
# AKKOMA_PORT=            # only when the public URL has a non-default port, e.g. 8080 for a local trial on http
# AKKOMA_REGISTRATIONS_OPEN=false
